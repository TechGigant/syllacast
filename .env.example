# ==============================================================================
# Syllacast Configuration Options
# ==============================================================================
# Copy this file to `.env` to configure your local Syllacast installation.

# --- Spicy Lyrics API ---
# Your Spicy Lyrics API secret key (obtainable from https://developers.spicylyrics.org)
SPICY_LYRICS_SECRET_KEY=sl_sk_your_api_key_here

# Optional: Override the default Spicy Lyrics API endpoint URL
# SPICY_LYRICS_API_URL=https://api.spicylyrics.org/v1/lyrics

# --- Network & Web Server ---
# Port for the web server and WebSocket connections (default: 8080)
SYLLACAST_PORT=8080

# Interface address to bind to (default: 0.0.0.0 for all interfaces)
SYLLACAST_BIND=0.0.0.0

# --- Spotify Soloist Integration ---
# Explicit WebSocket URL for Spotify Soloist daemon (e.g. ws://127.0.0.1:9090).
# If omitted, Syllacast automatically discovers Soloist from local runtime files.
# SOLOIST_WS_URL=ws://127.0.0.1:9090

# Optional: Explicit path to Spotify Soloist data directory containing `ws.addr` and `ws.port`.
# If omitted, standard system directories are automatically scanned.
# SOLOIST_DATA_DIR=/path/to/soloist/data

# --- Storage & Directories ---
# Directory for saving display settings (`syllacast_settings.json`).
# Defaults to your OS user config directory (~/.config/syllacast, %APPDATA%\syllacast).
# SYLLACAST_CONFIG_DIR=/path/to/config

# Directory for caching fetched lyrics on disk (30-day compliance TTL).
# Defaults to your OS user cache directory (~/.cache/syllacast, %LOCALAPPDATA%\syllacast).
# LYRICS_CACHE_DIR=/path/to/cache

# Optional: Path to an external frontend static assets directory.
# Syllacast includes all web assets embedded directly in the single binary by default.
# Only set this if you want to override embedded assets with a custom external folder.
# FRONTEND_DIST=/path/to/frontend/dist

# --- Automated Updates ---
# Optional: Explicit destination executable path for automated GitHub release updates.
# If omitted, Syllacast automatically replaces the currently running binary (even on custom paths),
# falling back to /opt/syllacast/syllacast for standard service installations.
# SYLLACAST_BIN_PATH=/opt/syllacast/syllacast
